# Copy to local.env (git-ignored) to keep this machine's private settings out of the repository.
# scripts/run.sh reads it before starting the app and the engine; every line is an environment variable.

# Open Meari from your phone over Tailscale: add this PC's Tailscale name
# SORINOTE_HOSTS=127.0.0.1,localhost,my-laptop.my-tailnet.ts.net

# Keep notes and recordings outside the repository (WSL path)
# SORINOTE_DATA=/mnt/d/meari-data

# Engine location and model (defaults shown)
# MEARI_NEMO_DIR=/root/nemo-speech
# MEARI_MODEL=/root/models/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-NVFP4

# Spoken language of your recordings: ko | en | auto
# MEARI_SPEECH_LANG=ko
