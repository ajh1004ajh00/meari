# Copy to local.env (git-ignored) to keep this machine's private settings out of the repository.
# The app server reads it at start; every line is an environment variable (real environment variables win).

# Open Meari from your phone over Tailscale: add this PC's Tailscale name
# SORINOTE_HOSTS=127.0.0.1,localhost,my-laptop.my-tailnet.ts.net

# Keep notes and recordings outside the repository
# SORINOTE_DATA=D:\meari-data

# Spoken language of your recordings: ko | en | auto
# MEARI_SPEECH_LANG=ko

# Speech engine: NeMo-Speech.cpp executable and the Nemotron 3.5 Transcribe decoder GGUF (encoder next to it)
# MEARI_ASR_EXE=D:\AI-Models\Speech\nemo-speech\bin\nemo-speech-0.3.0-windows-aarch64-cuda\bin\nemo-speech.exe
# MEARI_ASR_MODEL=D:\AI-Models\Speech\nemo-speech\models\NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-AD-NVFP4.gguf

# Summary engine: llama-server plus a Hermes preset name, or a GGUF path
# MEARI_LLAMA_SERVER=D:\Tools\local-vlm\llamacpp\llama-server.exe
# MEARI_LLM=Qwen3.8-27B-UD-Q4_K_M
# MEARI_LLM_MODEL=D:\models\my-model.gguf

# Keep both engines loaded while they fit (GB); above it they take turns
# MEARI_GPU_BUDGET_GB=80

# ffmpeg for uploaded audio/video files
# MEARI_FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe
